# Pinned coordinate of the rk3588-media-island multi_rga driver UAPI header.
#
# This is the ONLY place the island coordinate is written down. The parity gate
# fetches the header from GitHub by raw URL at this ref and refuses to proceed
# unless the bytes hash to ISLAND_RGA_H_SHA256. Nothing here may name a local
# sibling checkout path, and ISLAND_REF may never be a branch name: a branch
# moves under the pin and would silently change what the gate asserts.
#
# ISLAND_REF is a PUBLISHED release tag. The plan that commissioned this gate
# warned that the RGA flip might have landed after the newest tag, in which case
# a 40-char commit SHA would have been required instead. That caveat turned out
# to be stale: as of 2026-09-05 the newest published island release is
# v2026.9.2 (2026-09-04), and its tree does carry the header --- blob
# 06659667b65f29f72bd362231e6ed60591d0f472, identical to the blob at v2026.9.1.
# So a tag pin was available and a tag pin is what we use.
#
# Moving this pin is a deliberate act. The upstream-watch job flags a newer
# island release; a human then moves ISLAND_REF, re-runs fetch-island-header.sh,
# and records the new sha256 in the same commit.

ISLAND_REPO=CERALIVE/rk3588-media-island
ISLAND_REF=v2026.9.2
ISLAND_RGA_H_PATH=drivers/video/rockchip/rga3/include/rga.h
ISLAND_RGA_H_SHA256=ac2f110c8b91ca4ba8de644dd88981560e9681978b99976ec1804654dee1ef35

# Provenance of the sha256 above, for anyone auditing the pin without network
# access: the file is 1012 lines / 20669 bytes and its git blob object id is
# 06659667b65f29f72bd362231e6ed60591d0f472.
ISLAND_RGA_H_BLOB=06659667b65f29f72bd362231e6ed60591d0f472
ISLAND_RGA_H_BYTES=20669
