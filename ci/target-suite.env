# The device target contract, in ONE place.
#
# Every value below is a property of the Debian suite the CeraLive device image
# ships, so they move together or not at all. A suite flip edits this file and
# nothing else: the release build runs in `debian:${TARGET_SUITE}-slim` on
# ${TARGET_ARCH}, and ci/check-abi-floors.sh rejects a built library that imports
# a symbol version above any floor named here.
#
# TARGET_SUITE is trixie because the shipped CeraLive image is Debian 13
# (root AGENTS.md, PLATFORM MIGRATION). The GLIBC/GLIBCXX/CXXABI floors are NOT
# independent pins — they are facts about the toolchain that suite ships, and the
# floor check derives the package version floors in packaging/build-deb.sh from
# the same numbers. Raising a floor here without rebuilding is meaningless; the
# check reads the binary, not this file's intent.
#
# Deliberately NOT here: any version of librga itself. The .deb version lives in
# packaging/version, and the SONAME is frozen in packaging/package-contract.sh.
TARGET_SUITE=trixie
TARGET_ARCH=arm64
TARGET_TRIPLET=aarch64-linux-gnu
GLIBC_FLOOR=2.41
GLIBCXX_FLOOR=3.4.33
CXXABI_FLOOR=1.3.15

# The second suite the hardware-independent build legs run in. It is NOT a
# runtime target: a package built on trixie imports symbol versions bookworm's
# glibc/libstdc++ do not have. The bookworm leg builds its OWN package from the
# same sources and smokes THAT one, which is what makes it a portability signal
# rather than a cross-suite install claim.
SECONDARY_SUITE=bookworm
